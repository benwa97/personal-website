---
// src/pages/reservoir.astro
//
// The gauge-station dashboard, ported into an Astro page. Styles live
// in src/styles/reservoir.css and are imported below so Astro/Vite
// fingerprints the built file (cache-busting on every deploy, same as
// the script bundle); the client-side logic lives in
// src/scripts/reservoir-app.js and is bundled by Astro/Vite (imports
// Chart.js as an npm dependency rather than loading it from a CDN at
// runtime).
//
// Data comes from /api/reservoir?dam=rice|willow, served by a
// Cloudflare Pages Function (see functions/api/reservoir.js or
// src/pages/api/reservoir.js) reading from a KV namespace that
// wvic-scraper-worker populates hourly.

import "../styles/reservoir.css";

const today = new Date();
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Reservoir Gauge — Tomahawk, WI</title>
    <meta name="description" content="Hourly tracker for the reservoirs near Tomahawk, WI, built from data published by WVIC. Not affiliated with WVIC.">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
</head>
<body>

<div class="paper-texture" aria-hidden="true"></div>

<header class="site-header">
  <div class="header-inner">
    <div class="brand">
      <span class="brand-mark" aria-hidden="true">
        <svg viewBox="0 0 40 40" width="34" height="34">
          <path d="M2 24 Q10 16 20 24 T38 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/>
          <path d="M2 31 Q10 23 20 31 T38 31" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" opacity="0.55"/>
          <path d="M6 12 L20 3 L34 12" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
      <div class="brand-text">
        <p class="eyebrow">Rice &amp; Willow Reservoirs &middot; Tomahawk, WI</p>
        <h1>Reservoir Gauge</h1>
      </div>
    </div>
    <div class="freshness" id="freshness">
      <span class="freshness-dot" id="freshness-dot" aria-hidden="true"></span>
      <span id="freshness-label">Loading readings&hellip;</span>
    </div>
  </div>

  <nav class="dam-tabs" role="tablist" aria-label="Select reservoir">
    <button class="dam-tab" data-dam="rice" role="tab" aria-selected="true" id="tab-rice">
      <span class="tab-index">01</span> Rice Reservoir
    </button>
    <button class="dam-tab" data-dam="willow" role="tab" aria-selected="false" id="tab-willow">
      <span class="tab-index">02</span> Willow Reservoir
    </button>
  </nav>
</header>

<main id="main">

  <p class="as-of">WVIC data as of <span id="as-of-time">&mdash;</span></p>

  <section class="gauge-row" aria-label="Current readings">
    <article class="gauge-plate accent" id="gauge-fbm">
      <div class="rivet tl"></div><div class="rivet tr"></div><div class="rivet bl"></div><div class="rivet br"></div>
      <p class="gauge-label">Feet Below Maximum</p>
      <p class="gauge-value"><span id="value-fbm">&mdash;</span><span class="gauge-unit">ft</span></p>
      <div class="gauge-ticks" aria-hidden="true"></div>
    </article>

    <article class="gauge-plate" id="gauge-head">
      <div class="rivet tl"></div><div class="rivet tr"></div><div class="rivet bl"></div><div class="rivet br"></div>
      <p class="gauge-label">Level Trend</p>
      <p class="gauge-value gauge-trend-value">
        <span class="gauge-trend-arrow" id="trend-arrow-head">&mdash;</span>
        <span id="value-head-trend">&mdash;</span>
      </p>
      <p class="gauge-trend-detail" id="value-head-trend-detail">&mdash;</p>
      <div class="gauge-ticks" aria-hidden="true"></div>
    </article>

    <article class="gauge-plate" id="gauge-flow">
      <div class="rivet tl"></div><div class="rivet tr"></div><div class="rivet bl"></div><div class="rivet br"></div>
      <p class="gauge-label">Gate Flow</p>
      <p class="gauge-value"><span id="value-flow">&mdash;</span><span class="gauge-unit">cfs</span></p>
      <div class="gauge-ticks" aria-hidden="true"></div>
    </article>
  </section>


  <section class="balance-panel" id="flow-balance-panel" aria-label="Inflow and outflow balance">
    <div class="panel-heading">
      <h2>Flow Balance</h2>
    </div>

    <div class="balance-hero">
      <div class="trend-icon" id="trend-icon">&mdash;</div>
      <div class="balance-hero-text">
        <p class="balance-hero-label" id="trend-label">Loading&hellip;</p>
        <p class="balance-hero-value"><span id="value-net-flow">&mdash;</span><span class="gauge-unit">cfs net</span></p>
      </div>
    </div>

    <div class="flow-bars">
      <div class="flow-bar-row">
        <span class="flow-bar-label">Inflow <span class="flow-bar-sublabel">(Willow release)</span></span>
        <div class="flow-bar-track"><div class="flow-bar-fill inflow" id="bar-inflow"></div></div>
        <span class="flow-bar-value" id="value-inflow">&mdash;</span>
      </div>
      <div class="flow-bar-row">
        <span class="flow-bar-label">Outflow</span>
        <div class="flow-bar-track"><div class="flow-bar-fill outflow" id="bar-outflow"></div></div>
        <span class="flow-bar-value" id="value-outflow-balance">&mdash;</span>
      </div>
    </div>

    <p class="balance-summary" id="balance-summary">&mdash;</p>

    <div class="sparkline-block">
      <p class="sparkline-label">Net flow, last 7 days <span class="sparkline-hint">(above the line = gaining, below = losing)</span></p>
      <div class="sparkline-frame">
        <canvas id="chart-netflow" height="64"></canvas>
      </div>
    </div>

    <p class="balance-caveat">
      Inflow data only reflects Willow Reservoir's release dam upstream &mdash;
      it doesn't account for other tributaries, precipitation, evaporation, or
      travel time between the two dams. Treat as directional guidance, not a
      precise forecast.
    </p>
  </section>


  <section class="table-panel" aria-label="Level trend and forecast" id="trend-forecast-panel">
    <div class="panel-heading">
      <h2>Level Trend &amp; Forecast <span class="beta-tag">Beta</span></h2>
    </div>
    <div class="table-scroll">
      <table>
        <thead>
          <tr>
            <th>Window</th>
            <th>Trend</th>
            <th>Change</th>
            <th>Projected Below Max</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>24h</td>
            <td><span class="gauge-trend-arrow" id="trend-fc-24h-arrow">&mdash;</span> <span id="trend-fc-24h-status">&mdash;</span></td>
            <td id="trend-fc-24h-change">&mdash;</td>
            <td id="trend-fc-24h-forecast">&mdash;</td>
          </tr>
          <tr>
            <td>3d</td>
            <td><span class="gauge-trend-arrow" id="trend-fc-3d-arrow">&mdash;</span> <span id="trend-fc-3d-status">&mdash;</span></td>
            <td id="trend-fc-3d-change">&mdash;</td>
            <td id="trend-fc-3d-forecast">&mdash;</td>
          </tr>
          <tr>
            <td>7d</td>
            <td><span class="gauge-trend-arrow" id="trend-fc-7d-arrow">&mdash;</span> <span id="trend-fc-7d-status">&mdash;</span></td>
            <td id="trend-fc-7d-change">&mdash;</td>
            <td id="trend-fc-7d-forecast">&mdash;</td>
          </tr>
        </tbody>
      </table>
    </div>
    <p class="balance-caveat">
      Projections are a naive linear extrapolation &mdash; they assume the
      recent trend continues unchanged and don't account for operational
      changes, precipitation, or evaporation. Treat as directional guidance,
      not a forecast.
    </p>
  </section>


  <section class="chart-panel" aria-label="Head level and freeboard over time">
    <div class="panel-heading">
      <h2>Head Level &amp; Freeboard</h2>
      <div class="range-toggle" role="group" aria-label="Time range">
        <button data-range="7" class="range-btn is-active">7d</button>
        <button data-range="30" class="range-btn">30d</button>
        <button data-range="all" class="range-btn">All</button>
      </div>
    </div>
    <div class="chart-frame">
      <canvas id="chart-level" height="280"></canvas>
    </div>
  </section>

  <section class="chart-panel" aria-label="Gate flow over time">
    <div class="panel-heading">
      <h2>Gate Flow</h2>
    </div>
    <div class="chart-frame">
      <canvas id="chart-flow" height="220"></canvas>
    </div>
  </section>

  <section class="table-panel" aria-label="Recent readings table">
    <div class="panel-heading">
      <h2>Recent Readings</h2>
    </div>
    <div class="table-scroll">
      <table id="readings-table">
        <thead>
          <tr>
            <th>Date &amp; Time</th>
            <th>Head Level</th>
            <th>Gate Flow</th>
            <th>Below Max</th>
          </tr>
        </thead>
        <tbody id="readings-tbody">
          <tr><td colspan="4" class="empty-row">Loading&hellip;</td></tr>
        </tbody>
      </table>
    </div>
  </section>

</main>

<footer class="site-footer">
  <p>
    Source data collected periodically from
    <a href="https://www.wvic.com/Content/Data--Reports.cfm" target="_blank" rel="noopener">wvic.com</a>.
    Data marked provisional, subject to revision.
  </p>
  <p class="disclaimer">
    This is an independent, unofficial dashboard and is not affiliated with,
    endorsed by, or sponsored by the Wisconsin Valley Improvement Company.
    Data is republished from WVIC's public website for convenience only and
    may be delayed, incomplete, or inaccurate &mdash; for authoritative,
    official information, refer directly to
    <a href="https://www.wvic.com" target="_blank" rel="noopener">wvic.com</a>.
  </p>
  <p class="copyright">
    &copy; {today.getFullYear()} <a href="https://benwa.dev">benwa.dev</a>
  </p>
</footer>

<script src="../scripts/reservoir-app.js"></script>
</body>
</html>
